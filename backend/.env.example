# Copy this file to .env (or export these in your shell / container /
# systemd unit) before running in anything but a throwaway local trial.

# Required for persistent logins across restarts. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated at startup and all sessions are
# invalidated the next time the process restarts.
WINECELLAR_SECRET_KEY=

# Where the SQLite database file lives. The parent directory is created
# automatically if missing.
WINECELLAR_DB_PATH=./data/winecellar.db

# How long a login session stays valid, in seconds. Default: 12 hours.
WINECELLAR_TOKEN_TTL_SECONDS=43200

# Default UI language when no Accept-Language header matches a known locale.
WINECELLAR_DEFAULT_LOCALE=en

# Comma-separated list of allowed origins for CORS, or "*" for any (fine
# when the frontend is served by this same process, as it is by default).
WINECELLAR_CORS_ORIGINS=*

# Directory containing the built frontend, served at "/". Defaults to
# ../frontend relative to the backend package.
WINECELLAR_FRONTEND_DIR=../frontend

# Login brute-force throttle.
WINECELLAR_LOGIN_MAX_ATTEMPTS=5
WINECELLAR_LOGIN_WINDOW_SECONDS=300
