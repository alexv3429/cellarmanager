# Copy this file to .env (or export these in your shell / container /
# systemd unit) before running in anything but a throwaway local trial.

# Required for persistent logins across restarts. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random secret is generated at startup and all sessions are
# invalidated the next time the process restarts.
WINECELLAR_SECRET_KEY=

# Where the SQLite database file lives. The parent directory is created
# automatically if missing.
WINECELLAR_DB_PATH=./data/winecellar.db

# How long a login session stays valid, in seconds. Default: 12 hours.
WINECELLAR_TOKEN_TTL_SECONDS=43200

# Default UI language when no Accept-Language header matches a known locale.
WINECELLAR_DEFAULT_LOCALE=en

# Comma-separated list of allowed origins for CORS, or "*" for any (fine
# when the frontend is served by this same process, as it is by default).
WINECELLAR_CORS_ORIGINS=

# Directory containing the built frontend, served at "/". Defaults to
# ../frontend relative to the backend package.
WINECELLAR_FRONTEND_DIR=../frontend

# Login brute-force throttle.
WINECELLAR_LOGIN_MAX_ATTEMPTS=5
WINECELLAR_LOGIN_WINDOW_SECONDS=300

# Recommended when the server is reachable before the owner account exists.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WINECELLAR_SETUP_TOKEN=

# Development only. Mock values are fabricated and are disabled by default.
WINECELLAR_ENABLE_DEMO_ENRICHMENT=false

# Evidence-backed Internet and AI enrichment (optional)
# API keys stay on the backend. Never commit a real key.
# WINECELLAR_OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_KEY=your-openai-api-key             # standard alias also accepted
WINECELLAR_ENRICHMENT_PROVIDER=openai_web
WINECELLAR_OPENAI_MODEL=gpt-5.5
WINECELLAR_OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative discovery mode: Brave Search supplies results and OpenAI extracts.
# BRAVE_SEARCH_API_KEY=...
# WINECELLAR_ENRICHMENT_PROVIDER=brave_openai

# Optional comma-separated domain allowlist for OpenAI web search.
WINECELLAR_ENRICHMENT_ALLOWED_DOMAINS=
WINECELLAR_ENRICHMENT_SEARCH_CONTEXT_SIZE=medium
WINECELLAR_ENRICHMENT_TIMEOUT_SECONDS=90
WINECELLAR_ENRICHMENT_MAX_JOBS_PER_DAY=20
WINECELLAR_ENRICHMENT_MAX_TOKENS_PER_MONTH=500000
WINECELLAR_ENRICHMENT_MAX_SOURCES=12
WINECELLAR_ENRICHMENT_MAX_PAIRINGS=8
WINECELLAR_ENRICHMENT_MAX_SEARCH_QUERIES=4
WINECELLAR_ENRICHMENT_MIN_IDENTITY_CONFIDENCE=0.60
WINECELLAR_ENRICHMENT_AUTO_APPLY_THRESHOLD=0.90
WINECELLAR_ENRICHMENT_STORE_RAW_RESPONSE=false

# Corporate TLS interception (for example Zscaler): use only the approved CA.
# WINECELLAR_ENRICHMENT_CA_BUNDLE=/absolute/path/to/company-ca.pem
