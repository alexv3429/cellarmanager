# Copy this file to docker/.env (same directory as docker-compose.yml) and
# fill in a real secret before running `docker compose up`. Compose loads
# ".env" here automatically - no extra flag needed.

# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WINECELLAR_SECRET_KEY=

WINECELLAR_DEFAULT_LOCALE=en
WINECELLAR_CORS_ORIGINS=*
