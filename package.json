{
  "name": "cellarmanager-workspace",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "repository:check": "node scripts/check_repository.mjs",
    "web:dev": "npm run dev --workspace @cellarmanager/web",
    "web:lint": "npm run lint --workspace @cellarmanager/web",
    "web:test": "npm run test --workspace @cellarmanager/web",
    "web:build": "npm run build --workspace @cellarmanager/web",
    "web:ci": "npm run web:lint && npm run web:test && npm run web:build",
    "ci": "npm run repository:check && npm run web:ci",
    "audit": "npm audit --omit=dev --audit-level=high",
    "supabase": "supabase"
  },
  "devDependencies": {
    "supabase": "^2.112.0",
    "wrangler": "^4.120.0"
  }
}
