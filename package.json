{
  "name": "cellarmanager-workspace",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "repository:check": "node scripts/check_repository.mjs",
    "release:check": "node scripts/check_release.mjs",
    "v01:metadata": "node scripts/v01/restore_metadata.mjs",
    "v01:test": "node --test scripts/v01/*.test.mjs",
    "lwin:import": "node scripts/lwin/import_snapshot.mjs",
    "lwin:test": "node --test scripts/lwin/*.test.mjs",
    "enrichment:trial": "node scripts/enrichment/provider_trial.mjs",
    "enrichment:review": "node scripts/enrichment/provider_review.mjs",
    "enrichment:inference": "node scripts/enrichment/inference_poc.mjs",
    "enrichment:test": "node --test scripts/enrichment/*.test.mjs",
    "invitations:test": "node --test scripts/invitations/*.test.mjs",
    "inventory:test": "node --test scripts/inventory/*.test.mjs",
    "inventory:acceptance": "node scripts/inventory/concurrent_acceptance.mjs",
    "web:dev": "npm run dev --workspace @cellarmanager/web",
    "web:lint": "npm run lint --workspace @cellarmanager/web",
    "web:test": "npm run test --workspace @cellarmanager/web",
    "web:build": "npm run build --workspace @cellarmanager/web",
    "web:ci": "npm run web:lint && npm run web:test && npm run web:build",
    "ci": "npm run repository:check && npm run release:check && npm run v01:test && npm run lwin:test && npm run enrichment:test && npm run invitations:test && npm run inventory:test && npm run web:ci",
    "audit": "npm audit --omit=dev --audit-level=high",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@excel.js/exceljs": "^0.12.0",
    "supabase": "^2.111.0",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "nodemailer": "^10.0.1"
  }
}
