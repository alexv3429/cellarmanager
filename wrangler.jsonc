{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cellarmanager",
  "main": "./workers/index.mjs",
  "compatibility_date": "2026-08-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
