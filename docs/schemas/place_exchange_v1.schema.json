{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexv3429/cellarmanager/blob/main/docs/schemas/place_exchange_v1.schema.json",
  "title": "CellarManager appellation and region profile exchange — 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "dataset_version", "generated_on", "language", "status", "profile_kind", "place", "ageing_groups", "facts", "sources"],
  "properties": {
    "format": {"const": "cellarmanager.place_profile"},
    "schema_version": {"const": "1.0.0"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_on": {"type": "string", "format": "date"},
    "language": {"type": "string", "minLength": 2, "maxLength": 12},
    "status": {"const": "draft_for_curator_review"},
    "profile_kind": {"enum": ["appellation", "region"]},
    "place": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "country_code", "source_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 200},
        "region": {"type": "string", "minLength": 2, "maxLength": 200},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 200}, "uniqueItems": true},
        "source_ids": {"$ref": "#/$defs/source_ids"}
      }
    },
    "ageing_groups": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "color", "definition", "source_ids", "members", "windows"],
        "properties": {
          "id": {"$ref": "#/$defs/local_id"},
          "name": {"type": "string", "minLength": 2, "maxLength": 80},
          "color": {"enum": ["red", "white", "rose", "sparkling", "sweet", "fortified", "other"]},
          "definition": {"type": "string", "minLength": 30, "maxLength": 2000},
          "source_ids": {"$ref": "#/$defs/source_ids"},
          "members": {
            "type": "array", "minItems": 1, "maxItems": 200,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "name", "rationale", "source_ids"],
              "properties": {
                "kind": {"enum": ["place", "product", "release"]},
                "name": {"type": "string", "minLength": 2, "maxLength": 200},
                "producer": {"type": "string", "minLength": 2, "maxLength": 200},
                "appellation": {"type": "string", "minLength": 2, "maxLength": 200},
                "vintage": {"type": "integer", "minimum": 1800, "maximum": 2200},
                "first_vintage": {"type": "integer", "minimum": 1800, "maximum": 2200},
                "last_vintage": {"type": "integer", "minimum": 1800, "maximum": 2200},
                "rationale": {"type": "string", "minLength": 30, "maxLength": 1000},
                "source_ids": {"$ref": "#/$defs/source_ids"}
              }
            }
          },
          "windows": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {"$ref": "#/$defs/window"}
          }
        }
      }
    },
    "facts": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "text", "source_ids"],
        "properties": {
          "kind": {"enum": ["history", "grapes", "style", "acidity", "sweetness", "body", "structure", "serving", "pairing"]},
          "text": {"type": "string", "minLength": 2, "maxLength": 2000},
          "source_ids": {"$ref": "#/$defs/source_ids"}
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "url", "checked_on", "reuse"],
        "properties": {
          "id": {"$ref": "#/$defs/local_id"},
          "title": {"type": "string", "minLength": 2, "maxLength": 200},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "checked_on": {"type": "string", "format": "date"},
          "reuse": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "store_raw_content", "pointer_candidate_only"],
            "properties": {
              "status": {"enum": ["rights_not_reviewed", "reuse_allowed", "restricted"]},
              "store_raw_content": {"const": false},
              "pointer_candidate_only": {"const": true}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"profile_kind": {"const": "appellation"}}},
     "then": {"properties": {"place": {"required": ["name", "region", "country_code", "source_ids"]}}}},
    {"if": {"properties": {"profile_kind": {"const": "region"}}},
     "then": {"properties": {"place": {"not": {"required": ["region"]}}}}}
  ],
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"},
    "source_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["vintage", "first_trial_year", "best_start_year", "best_end_year", "rationale", "date_origin", "confidence", "source_ids", "review_status"],
      "properties": {
        "vintage": {"type": "integer", "minimum": 1800, "maximum": 2200},
        "first_trial_year": {"type": "integer", "minimum": 1800, "maximum": 2300},
        "best_start_year": {"type": "integer", "minimum": 1800, "maximum": 2300},
        "best_end_year": {"type": "integer", "minimum": 1800, "maximum": 2300},
        "rationale": {"type": "string", "minLength": 30, "maxLength": 2000},
        "date_origin": {"enum": ["curator_model_estimate_not_source_fact", "source_stated_three_dates_pending_review"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "source_ids": {"$ref": "#/$defs/source_ids"},
        "review_status": {"const": "candidate_not_approved"}
      }
    }
  }
}
